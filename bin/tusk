#!/usr/bin/env php
<?php

// Tusk CLI Entry Point

$autoloadFiles = [
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php', // In case tusk is a global dependency or vendor installed
];

$autoloadFile = null;
foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        $autoloadFile = $file;
        break;
    }
}

if (! $autoloadFile) {
    fwrite(STDERR, 'You must set up the project dependencies using `composer install`.'.PHP_EOL);
    exit(1);
}

require $autoloadFile;

$workingDirectory = getcwd() ?: '.';
$projectRoot = realpath($workingDirectory) ?: $workingDirectory;
$directory = $projectRoot;
while (true) {
    if (is_file($directory.'/tusk.json')) {
        $projectRoot = $directory;
        break;
    }

    $parentDirectory = dirname($directory);
    if ($parentDirectory === $directory) {
        break;
    }

    $directory = $parentDirectory;
}

// A project may invoke this entry point through a globally installed Tusk CLI.
// Load the project's Composer autoloader without booting its application.
$projectAutoloadFile = $projectRoot.'/vendor/autoload.php';
if (is_file($projectAutoloadFile) && realpath($projectAutoloadFile) !== realpath($autoloadFile)) {
    require_once $projectAutoloadFile;
}

use Symfony\Component\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Tusk\Cli\Command\FrameworkCommandCatalog;
use Tusk\Cli\Command\FrameworkCommandLoader;

$application = new Application('Tusk Framework CLI', '0.1.0');
$frameworkCatalog = new FrameworkCommandCatalog($projectRoot);
$compiledCommands = [];
$registryPath = $projectRoot.'/.tusk/CompiledCommandRegistry.php';
$containerPath = $projectRoot.'/.tusk/CompiledContainer.php';

// Config validation stays independent of compiled application artifacts.
if ((new ArgvInput)->getFirstArgument() !== 'config:validate' && is_file($registryPath) && is_file($containerPath)) {
    try {
        require_once $registryPath;
        require_once $containerPath;
        if (class_exists('Tusk\\Compiled\\CompiledCommandRegistry') && class_exists('Tusk\\Compiled\\CompiledContainer')) {
            $compiledCommands = Tusk\Compiled\CompiledCommandRegistry::getCommands();
        }
    } catch (Throwable) {
        // A missing or stale application registry leaves Framework-owned commands available.
    }
}

$compiledContainer = null;
$resolveApplicationCommand = static function (string $class) use (&$compiledContainer): object {
    if ($compiledContainer === null) {
        $compiledContainer = new Tusk\Compiled\CompiledContainer;
    }

    return $compiledContainer->get($class);
};

$application->setCommandLoader(new FrameworkCommandLoader(
    $frameworkCatalog,
    $compiledCommands,
    $resolveApplicationCommand,
));

$application->run();
